# Copy to .env and fill in. Never commit .env.
# World Labs Atlas / Marble 2 Beta API
WLT_API_BASE_URL=https://api.atlas-beta.worldlabs.ai/api/v2
WLT_API_KEY=

# Duat operator settings
# OPERATOR_API_KEY=        # required in production; when set, all /api/* need `X-Duat-Key`
# VITE_OPERATOR_API_KEY=   # optional frontend build-time default for `X-Duat-Key`
# DUAT_CORS_ORIGINS=http://localhost:5173
# ATLAS_CREDITS_PER_CHISEL_1T=   # your platform rate card: credits per 1-target call
# ATLAS_CREDITS_PER_CHISEL_32T=  # your platform rate card: credits per 32-target call
# DUAT_RATE_LIMIT_PER_MIN=30  # local per-IP cap on expensive POST endpoints
